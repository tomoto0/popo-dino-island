; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/image="res://assets/game/ui/boot_splash.png"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.23137, 0.14118, 0.07843, 1)




config/name="ポポのダイノアイランド"
config/icon="res://assets/share/favicon.png"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"

I18n="*res://autoload/i18n.gd"

ManusFontTheme="*res://autoload/manus_font_theme.gd"

ViewportPolicy="*res://scripts/viewport_policy.gd"
GameAudio="*res://scripts/game_audio.gd"
SaveStore="*res://scripts/save_store.gd"
TuningStore="*res://scripts/tuning_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

